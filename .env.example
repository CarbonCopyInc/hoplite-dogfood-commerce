# The storefront boots in demo mode against a built-in in-memory catalog when
# SHOPIFY_STORE_DOMAIN and SHOPIFY_STOREFRONT_ACCESS_TOKEN are not set, so the
# home page, product pages, search, and cart all render without a real store.
#
# To switch to a real store, set the two Shopify variables below (and, if you
# use Shopify webhooks, SHOPIFY_REVALIDATION_SECRET), then restart the dev
# server. The demo catalog is used only while both are unset.
COMPANY_NAME="Vercel Inc."
SITE_NAME="Next.js Commerce"
SHOPIFY_REVALIDATION_SECRET=""
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
SHOPIFY_STORE_DOMAIN="[your-shopify-store-subdomain].myshopify.com"

# Server-only secret read by lib/demo-api.ts. Set the real value in your
# environment; never commit it.
DEMO_API_KEY="[your-demo-api-key]"
